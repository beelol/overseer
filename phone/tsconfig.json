{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "moduleSuffixes": [
      ".ios",
      ".android",
      ""
    ],
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "app",
    "src",
    "scripts",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules",
    "ios",
    "android",
    "core/test",
    "core/scripts",
    "model/test",
    "model/scripts",
    "integration"
  ]
}
