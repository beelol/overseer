{
  "name": "overseer-phone",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild": "node scripts/clean-native.mjs && expo prebuild --clean",
    "ios": "node scripts/run-ios.mjs",
    "ios:release": "node scripts/run-ios.mjs --release",
    "android": "node scripts/run-android.mjs",
    "android:release": "node scripts/run-android.mjs --release",
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check:platform-rule": "node scripts/check-platform-rule.mjs",
    "check": "npm run tokens:check && npm run icons:check && npm run lint && npm run typecheck && npm test && npm run check:platform-rule",
    "assets": "node scripts/gen-assets.mjs",
    "format": "prettier --write app src scripts \"*.{js,ts,json,md}\"",
    "icons": "node scripts/gen-icons.mjs",
    "icons:check": "node scripts/gen-icons.mjs --check"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "$react"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-notifications"
        ]
      }
    }
  }
}
