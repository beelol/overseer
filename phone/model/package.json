{
  "name": "@overseer/phone-model",
  "version": "0.1.0",
  "private": true,
  "description": "The view models of Overseer's phone app: the daemon's state and events turned into exactly what the screens show. Pure TypeScript, no React, no DOM.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "record": "node scripts/record.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
