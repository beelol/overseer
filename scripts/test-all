#!/usr/bin/env node
// Runs every test and prints one summary (AC-147):
//   Rust      cargo test --workspace (daemon and TUI)
//   Unit      node test/unit/run.js (extension unit tests)
//   Check     npm run check --prefix extension (syntax of the extension's sources)
//   Links     scripts/check-links (every relative link in the README and the ledger, AC-153)
//   Dev       test/dev/run.js (dev daemons through scripts/dev beside a temporary production, Gate T)
//   Deploy    test/deploy/run.js (scripts/deploy onto a temporary production, AC-214)
//   UI        the packaged-VSIX fixture scenarios in test/ui (built VSIX, isolated VS Code profiles)
// Flags: --no-ui (skip UI), --only=a,b (UI scenarios by name), --live (also the LIVE scenarios, which
// spend paid turns within the budget in AGENTS.md), --perf (also the ten-minute AC-35 load test),
// --jobs=N (run N UI scenarios at once; each has its own VS Code profile, ports and evidence folder,
// so 3 or 4 cut the UI part from about 50 minutes to about 15 on one machine).
// Exit code 1 when anything fails.
const fs = require('fs');
const path = require('path');
const cp = require('child_process');

const root = path.resolve(__dirname, '..');

// One full run at a time on this machine: several agents running test-all at once load the Mac
// until timing checks fail for everyone. A run waits for the lock; a lock whose process has died
// is taken over. OVERSEER_TEST_LOCK=off skips it (a CI runner has the machine to itself).
(function takeTheMachineLock() {
  if (process.env.OVERSEER_TEST_LOCK === 'off') return;
  const lock = path.join(require('os').tmpdir(), 'overseer-test-all.lock');
  const alive = pid => { try { process.kill(pid, 0); return true; } catch { return false; } };
  let told = false;
  for (;;) {
    try { fs.mkdirSync(lock); fs.writeFileSync(path.join(lock, 'pid'), `${process.pid} ${root}\n`); break; } catch {}
    let holder = '';
    try { holder = fs.readFileSync(path.join(lock, 'pid'), 'utf8').trim(); } catch {}
    const pid = parseInt(holder, 10);
    if (!pid || !alive(pid)) { fs.rmSync(lock, { recursive: true, force: true }); continue; }
    if (!told) { console.log(`waiting for another test-all run to finish (${holder})`); told = true; }
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 15000);
  }
  const release = () => { try { if (fs.readFileSync(path.join(lock, 'pid'), 'utf8').startsWith(`${process.pid} `)) fs.rmSync(lock, { recursive: true, force: true }); } catch {} };
  process.on('exit', release);
  for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.on(sig, () => { release(); process.exit(130); });
})();
const args = process.argv.slice(2);
const flag = f => args.includes(f);
const only = (args.find(a => a.startsWith('--only=')) || '').slice(7).split(',').filter(Boolean);
const env = { ...process.env };
const jobs = Math.max(1, Math.min(8, Number((args.find(a => a.startsWith('--jobs=')) || '').slice(7)) || 1));

// Git must work for the tests (they create repositories). If the system git refuses to run (for
// example an unaccepted Xcode license), use the Command Line Tools' git (AC-159).
function gitWorks(e) { return cp.spawnSync('git', ['--version'], { env: e, encoding: 'utf8' }).status === 0; }
if (!gitWorks(env)) {
  const clt = '/Library/Developer/CommandLineTools';
  if (fs.existsSync(path.join(clt, 'usr/bin/git')) && gitWorks({ ...env, DEVELOPER_DIR: clt })) {
    env.DEVELOPER_DIR = clt;
    console.log('note: the system git would not run; using the Command Line Tools git');
  } else {
    console.error('git does not run on this machine; the tests need it'); process.exit(1);
  }
}

const results = [];
function run(name, cmd, cmdArgs, opts = {}) {
  const t0 = Date.now();
  process.stdout.write(`▶ ${name} … `);
  const r = cp.spawnSync(cmd, cmdArgs, { cwd: opts.cwd || root, env, encoding: 'utf8', maxBuffer: 256 * 1024 * 1024 });
  const out = (r.stdout || '') + (r.stderr || '');
  const ok = r.status === 0 && (!opts.okText || opts.okText.test(out));
  const detail = opts.summary ? opts.summary(out) : '';
  const s = Math.round((Date.now() - t0) / 1000);
  console.log(`${ok ? 'ok' : 'FAILED'} (${s}s)${detail ? ' ' + detail : ''}`);
  if (!ok) console.log(out.split('\n').filter(l => /FAIL|error|panicked|ERROR|✗/.test(l)).slice(0, 12).map(l => '    ' + l.slice(0, 200)).join('\n'));
  results.push({ name, ok, s, detail });
  return ok;
}

/** UI scenarios `jobs` at a time; each result prints when it finishes, in the same form as run(). */
function parallel(names) {
  const queue = [...names];
  const one = () => new Promise(resolve => {
    const n = queue.shift(); if (!n) return resolve();
    const t0 = Date.now(); let out = '';
    const child = cp.spawn('node', [`test/ui/scenario-${n}.js`], { cwd: root, env });
    child.stdout.on('data', d => { out += d; }); child.stderr.on('data', d => { out += d; });
    child.on('close', code => {
      const ok = code === 0 && /SCENARIO PASSED/.test(out), s = Math.round((Date.now() - t0) / 1000);
      console.log(`▶ UI ${n} … ${ok ? 'ok' : 'FAILED'} (${s}s)`);
      if (!ok) console.log(out.split('\n').filter(l => /FAIL|error|ERROR|✗/.test(l)).slice(0, 12).map(l => '    ' + l.slice(0, 200)).join('\n'));
      results.push({ name: `UI ${n}`, ok, s });
      one().then(resolve);
    });
  });
  console.log(`(UI scenarios, ${jobs} at a time)`);
  return Promise.all(Array.from({ length: Math.min(jobs, names.length) }, one));
}

(async () => {
// Rust: daemon and TUI.
run('Rust (cargo test --workspace)', 'cargo', ['test', '--workspace'], {
  summary: out => { const m = [...out.matchAll(/test result: \w+\. (\d+) passed; (\d+) failed/g)]; const p = m.reduce((n, x) => n + +x[1], 0), f = m.reduce((n, x) => n + +x[2], 0); return `${p} passed, ${f} failed`; },
});
// Extension unit tests and source check.
run('Unit (test/unit)', 'node', ['test/unit/run.js'], { summary: out => (out.match(/(\d+) of (\d+) passed/) || [''])[0] });
run('Check (extension sources)', 'npm', ['run', '--silent', 'check', '--prefix', 'extension']);
run('Links (README and ledger)', 'node', ['scripts/check-links'], { summary: out => (out.match(/(\d+) links checked.*?(\d+) broken/) || [''])[0] });
// Dev daemons beside a temporary "production" (Gate T): scripts/dev with a temporary HOME and dev root.
run('Dev daemons (test/dev)', 'node', ['test/dev/run.js'], { summary: out => (out.match(/(\d+) of (\d+) passed/) || [''])[0] });
// Guided owner tests (AC-215): every owner-check file, and a fixture check run step by step.
run('Guided owner tests (test/dev/guided.js)', 'node', ['test/dev/guided.js'], { summary: out => (out.match(/(\d+) of (\d+) passed/) || [''])[0] });
// Deploy onto a temporary production (AC-214): builds two commits in its own clone, installs into a temporary VS Code profile.
run('Deploy (test/deploy)', 'node', ['test/deploy/run.js'], { summary: out => (out.match(/(\d+) of (\d+) passed/) || [''])[0] });

// UI: every fixture scenario (LIVE ones and perf only when asked).
if (!flag('--no-ui')) {
  const dir = path.join(root, 'test/ui');
  const all = fs.readdirSync(dir).filter(f => /^scenario-.+\.js$/.test(f)).map(f => f.slice(9, -3)).sort();
  const isLive = n => /LIVE/.test(fs.readFileSync(path.join(dir, `scenario-${n}.js`), 'utf8').split('\n')[0]);
  const chosen = all.filter(n => (!only.length || only.includes(n)) && (flag('--live') || !isLive(n)) && (flag('--perf') || n !== 'perf'));
  if (run('Build the VSIX', 'node', ['extension/scripts/package.js'])) {
    if (jobs === 1) for (const n of chosen) run(`UI ${n}`, 'node', [`test/ui/scenario-${n}.js`], { okText: /SCENARIO PASSED/ });
    else await parallel(chosen);
  }
  const skipped = all.filter(n => !chosen.includes(n) && (!only.length || only.includes(n)));
  if (skipped.length) console.log(`(not run: ${skipped.join(', ')}; ${flag('--live') ? '' : 'LIVE ones need --live, '}perf needs --perf)`);
}

const failed = results.filter(r => !r.ok);
console.log(`\n${results.length - failed.length} of ${results.length} passed${failed.length ? '; failed: ' + failed.map(r => r.name).join(', ') : ''}`);
process.exit(failed.length ? 1 : 0);
})();
