{
  "name": "overseer",
  "displayName": "Overseer",
  "description": "Launch and supervise account-authenticated agent harnesses, follow their native children, and review/edit their worktrees live (review built on Branch Diff).",
  "version": "0.1.0",
  "publisher": "beelol",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/beelol/overseer.git" },
  "engines": { "vscode": "^1.136.0" },
  "categories": ["SCM Providers", "Other"],
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:overseer.review", "onWebviewPanel:overseer.output", "onWebviewPanel:overseer.center", "onUri"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Overseer can show existing agent runs in restricted mode, but launching or controlling agents requires a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "themes": [
      { "label": "Overseer Dark", "uiTheme": "vs-dark", "path": "./themes/overseer-dark-color-theme.json" },
      { "label": "Overseer Light", "uiTheme": "vs", "path": "./themes/overseer-light-color-theme.json" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "overseer", "title": "Overseer", "icon": "media/overseer.svg" }]
    },
    "views": {
      "overseer": [
        { "id": "overseer.agents", "name": "Agents" },
        { "id": "overseer.dirty", "name": "Workspace Dirty" },
        { "id": "overseer.accounts", "name": "Accounts" }
      ]
    },
    "viewsWelcome": [
      { "view": "overseer.agents", "contents": "No agent tasks yet.\n[New Task](command:overseer.newTask)\nOverseer runs agents through a local daemon; closing VS Code does not stop them.", "when": "isWorkspaceTrusted" },
      { "view": "overseer.agents", "contents": "Launching agents requires a trusted workspace.\n[Manage Workspace Trust](command:workbench.trust.manage)", "when": "!isWorkspaceTrusted" }
    ],
    "commands": [
      { "command": "overseer.openCenter", "title": "Open Overseer View", "category": "Overseer", "icon": "$(layout)" },
      { "command": "overseer.openDashboard", "title": "Open Dashboard", "category": "Overseer", "icon": "$(screen-full)" },
      { "command": "overseer.exitDashboard", "title": "Exit Dashboard", "category": "Overseer", "icon": "$(screen-normal)", "enablement": "overseer.inDashboard" },
      { "command": "overseer.toggleDashboard", "title": "Toggle Dashboard", "category": "Overseer" },
      { "command": "overseer.openDashboardWindow", "title": "Open Dashboard in New Window", "category": "Overseer", "icon": "$(empty-window)" },
      { "command": "overseer.newAgent", "title": "New Agent", "category": "Overseer", "icon": "$(add)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.toggleGrid", "title": "Toggle Agent Grid", "category": "Overseer", "icon": "$(layout)" },
      { "command": "overseer.switchAgent", "title": "Switch Agent…", "category": "Overseer", "icon": "$(list-selection)" },
      { "command": "overseer.nextNeedsYou", "title": "Go to Next Agent That Needs You", "category": "Overseer", "icon": "$(bell-dot)" },
      { "command": "overseer.allowPermission", "title": "Allow Pending Request", "category": "Overseer", "icon": "$(check)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.denyPermission", "title": "Deny Pending Request", "category": "Overseer", "icon": "$(circle-slash)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.stopSelected", "title": "Stop Selected Agent", "category": "Overseer", "icon": "$(debug-stop)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.cleanupArchived", "title": "Clean Up Archived Worktrees…", "category": "Overseer", "icon": "$(trash)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.newTask", "title": "New Task…", "category": "Overseer", "icon": "$(add)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.newTaskQuick", "title": "Start Task with Quick Picks…", "category": "Overseer", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.refresh", "title": "Refresh", "category": "Overseer", "icon": "$(refresh)" },
      { "command": "overseer.openReview", "title": "Open Review", "category": "Overseer", "icon": "$(diff-multiple)" },
      { "command": "overseer.showOutput", "title": "Show Output", "category": "Overseer", "icon": "$(output)" },
      { "command": "overseer.followUp", "title": "Send Follow-up…", "category": "Overseer", "icon": "$(comment)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.interrupt", "title": "Interrupt", "category": "Overseer", "icon": "$(debug-stop)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.selectComparison", "title": "Select Comparison…", "category": "Overseer", "icon": "$(git-compare)" },
      { "command": "overseer.cleanupWorkspace", "title": "Clean Up Worktree…", "category": "Overseer", "icon": "$(trash)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.addProfile", "title": "Add Account…", "category": "Overseer", "icon": "$(person-add)" },
      { "command": "overseer.removeAccount", "title": "Remove Account…", "category": "Overseer", "icon": "$(trash)" },
      { "command": "overseer.signIn", "title": "Sign In…", "category": "Overseer", "icon": "$(sign-in)" },
      { "command": "overseer.signOut", "title": "Sign Out", "category": "Overseer", "icon": "$(sign-out)" },
      { "command": "overseer.renameProfile", "title": "Rename Account…", "category": "Overseer", "icon": "$(edit)" },
      { "command": "overseer.refreshAccounts", "title": "Refresh Account Status", "category": "Overseer", "icon": "$(refresh)" },
      { "command": "overseer.openDirtyDiff", "title": "Open Diff", "category": "Overseer" },
      { "command": "overseer.openEdit", "title": "Open Edit in Review", "category": "Overseer" },
      { "command": "overseer.showCapabilities", "title": "Show Harness Capabilities", "category": "Overseer", "icon": "$(info)" },
      { "command": "overseer.openPullRequest", "title": "Open Pull Request…", "category": "Overseer", "icon": "$(git-pull-request)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.mergeBack", "title": "Merge Back…", "category": "Overseer", "icon": "$(git-merge)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.stopAll", "title": "Stop Agents and Daemon…", "category": "Overseer", "icon": "$(debug-stop)" },
      { "command": "overseer.startDaemon", "title": "Start Daemon", "category": "Overseer" },
      { "command": "overseer.audioMode", "title": "Audio Mode and Reactor Cues…", "category": "Overseer", "icon": "$(unmute)" },
      { "command": "overseer.testNotification", "title": "Test Notification", "category": "Overseer", "icon": "$(bell)" },
      { "command": "overseer.showLog", "title": "Show Daemon Log", "category": "Overseer" },
      { "command": "overseer.restartDaemonConnection", "title": "Reconnect to Daemon", "category": "Overseer" }
    ],
    "keybindings": [
      { "command": "overseer.toggleDashboard", "key": "ctrl+alt+o", "mac": "cmd+alt+o" },
      { "command": "overseer.newAgent", "key": "ctrl+alt+n", "mac": "cmd+alt+n" },
      { "command": "overseer.toggleGrid", "key": "ctrl+alt+g", "mac": "cmd+alt+g" },
      { "command": "overseer.switchAgent", "key": "ctrl+alt+a", "mac": "cmd+alt+a" },
      { "command": "overseer.nextNeedsYou", "key": "ctrl+alt+j", "mac": "cmd+alt+j" },
      { "command": "overseer.allowPermission", "key": "ctrl+alt+y", "mac": "cmd+alt+y", "when": "overseer.connected" },
      { "command": "overseer.denyPermission", "key": "ctrl+alt+x", "mac": "cmd+alt+backspace", "when": "overseer.connected" },
      { "command": "overseer.stopSelected", "key": "ctrl+alt+.", "mac": "cmd+alt+.", "when": "overseer.connected" }
    ],
    "menus": {
      "view/title": [
        { "command": "overseer.newTask", "when": "view == overseer.agents", "group": "navigation@1" },
        { "command": "overseer.openDashboard", "when": "view == overseer.agents", "group": "navigation@0" },
        { "command": "overseer.switchAgent", "when": "view == overseer.agents", "group": "navigation@4" },
        { "command": "overseer.refresh", "when": "view == overseer.agents", "group": "navigation@2" },
        { "command": "overseer.showCapabilities", "when": "view == overseer.agents", "group": "navigation@3" },
        { "command": "overseer.audioMode", "when": "view == overseer.agents", "group": "navigation@5" },
        { "command": "overseer.stopAll", "when": "view == overseer.agents", "group": "9_stop@1" },
        { "command": "overseer.addProfile", "when": "view == overseer.accounts", "group": "navigation@1" },
        { "command": "overseer.refreshAccounts", "when": "view == overseer.accounts", "group": "navigation@2" },
        { "command": "overseer.selectComparison", "when": "view == overseer.dirty", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "overseer.openReview", "when": "view == overseer.agents && viewItem =~ /run/", "group": "inline@1" },
        { "command": "overseer.showOutput", "when": "view == overseer.agents && viewItem =~ /run/", "group": "inline@2" },
        { "command": "overseer.interrupt", "when": "view == overseer.agents && viewItem =~ /run-root-active/", "group": "inline@3" },
        { "command": "overseer.followUp", "when": "view == overseer.agents && viewItem =~ /run-root/", "group": "1_control@1" },
        { "command": "overseer.selectComparison", "when": "view == overseer.agents && viewItem =~ /run/", "group": "1_control@2" },
        { "command": "overseer.mergeBack", "when": "view == overseer.agents && viewItem =~ /run-root/", "group": "1_control@3" },
        { "command": "overseer.openPullRequest", "when": "view == overseer.agents && viewItem =~ /run-root/", "group": "1_control@4" },
        { "command": "overseer.cleanupWorkspace", "when": "view == overseer.agents && viewItem =~ /run-root/", "group": "9_cleanup@1" },
        { "command": "overseer.signIn", "when": "view == overseer.accounts && viewItem =~ /^profile-.*-signedout$/", "group": "inline@1" },
        { "command": "overseer.signIn", "when": "view == overseer.accounts && viewItem =~ /^profile-/", "group": "1_edit@0" },
        { "command": "overseer.renameProfile", "when": "view == overseer.accounts && viewItem =~ /profile-isolated/", "group": "1_edit@1" },
        { "command": "overseer.signOut", "when": "view == overseer.accounts && viewItem =~ /^profile-isolated-signedin$/", "group": "1_edit@2" },
        { "command": "overseer.removeAccount", "when": "view == overseer.accounts && viewItem =~ /profile-isolated/", "group": "9_remove@1" },
        { "command": "overseer.addProfile", "when": "view == overseer.accounts && viewItem == provider", "group": "inline@1" }
      ],
      "commandPalette": [
        { "command": "overseer.openDirtyDiff", "when": "false" },
        { "command": "overseer.openEdit", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Overseer",
      "properties": {
        "overseer.grid.maxTiles": { "type": "integer", "minimum": 1, "maximum": 9, "default": 6, "markdownDescription": "Most agents shown at once in the agent grid (1–9)." },
        "overseer.dashboard.openOnStartup": { "type": "boolean", "default": false, "markdownDescription": "Open the Overseer dashboard when VS Code starts." },
        "overseer.history.autoArchiveDays": { "type": "number", "minimum": 0, "default": 14, "markdownDescription": "Archive finished agents automatically after this many days (0 turns it off). Archived agents stay searchable and can be restored." },
        "overseer.showCodexAppServer": { "type": "boolean", "default": false, "markdownDescription": "Offer the Codex app-server harness in the new-agent composer (the New Task form always lists it)." },
        "overseer.github.apiUrl": { "type": "string", "default": "https://api.github.com", "description": "GitHub API base URL used by Open Pull Request (GitHub Enterprise: https://HOST/api/v3). Pull requests use the GitHub account VS Code is signed in to." },
        "overseer.daemonPath": { "type": "string", "default": "", "markdownDescription": "Path to the `overseerd` binary. Empty uses the binary bundled with the extension.", "scope": "machine" },
        "overseer.review.enableEditing": { "type": "boolean", "default": true, "markdownDescription": "Edit working-tree text directly in the review. Undo/redo is available through Open in Native Diff." },
        "overseer.review.largeDiffThreshold": { "type": "integer", "minimum": 1, "default": 500, "markdownDescription": "Show a Load Diff card when additions + deletions exceed this count." },
        "overseer.followNewRuns": { "type": "boolean", "default": true, "markdownDescription": "Turn Follow on for runs you launch from this window. Selecting an existing run never turns Follow on." }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/daemon-client.js && node --check src/views.js && node --check src/review.js && node --check src/output-panel.js && node --check branch-diff/review/panel.js",
    "build:review": "node branch-diff/scripts/build-review.js",
    "package": "node scripts/package.js",
    "test": "node test/run.js"
  }
}
