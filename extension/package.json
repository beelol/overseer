{
  "name": "overseer",
  "displayName": "Overseer",
  "description": "Launch and supervise account-authenticated agent harnesses, follow their native children, and review/edit their worktrees live (review built on Branch Diff).",
  "version": "0.1.0",
  "publisher": "beelol",
  "icon": "media/overseer-app-icon.png",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/beelol/overseer.git" },
  "engines": { "vscode": "^1.136.0" },
  "categories": ["SCM Providers", "Other"],
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:overseer.review", "onWebviewPanel:overseer.output", "onWebviewPanel:overseer.center", "onCustomEditor:overseer.chatEditor", "onFileSystem:overseer-chat", "onUri"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Overseer can show existing agent runs in restricted mode, but launching or controlling agents requires a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "themes": [
      { "label": "Overseer Dark", "uiTheme": "vs-dark", "path": "./themes/overseer-dark-color-theme.json" },
      { "label": "Overseer Light", "uiTheme": "vs", "path": "./themes/overseer-light-color-theme.json" },
      { "label": "Overseer", "uiTheme": "vs-dark", "path": "./themes/overseer-color-theme.json" }
    ],
    "colors": [
      { "id": "overseer.backdropStart", "description": "Overseer views: top of the backdrop gradient.", "defaults": { "dark": "editor.background", "light": "editor.background", "highContrast": "editor.background", "highContrastLight": "editor.background" } },
      { "id": "overseer.backdropEnd", "description": "Overseer views: bottom of the backdrop gradient.", "defaults": { "dark": "editor.background", "light": "editor.background", "highContrast": "editor.background", "highContrastLight": "editor.background" } },
      { "id": "overseer.glow", "description": "Overseer views: the soft light in the backdrop's top corner.", "defaults": { "dark": "#00000000", "light": "#00000000", "highContrast": "#00000000", "highContrastLight": "#00000000" } },
      { "id": "overseer.chromeStart", "description": "Overseer side bar header: top of its gradient.", "defaults": { "dark": "sideBar.background", "light": "sideBar.background", "highContrast": "sideBar.background", "highContrastLight": "sideBar.background" } },
      { "id": "overseer.chromeEnd", "description": "Overseer side bar header: bottom of its gradient.", "defaults": { "dark": "sideBar.background", "light": "sideBar.background", "highContrast": "sideBar.background", "highContrastLight": "sideBar.background" } },
      { "id": "overseer.surfaceStart", "description": "Overseer grid tiles and cards: top of their gradient.", "defaults": { "dark": "editor.background", "light": "editor.background", "highContrast": "editor.background", "highContrastLight": "editor.background" } },
      { "id": "overseer.surfaceEnd", "description": "Overseer grid tiles and cards: bottom of their gradient.", "defaults": { "dark": "editor.background", "light": "editor.background", "highContrast": "editor.background", "highContrastLight": "editor.background" } },
      { "id": "overseer.accentStart", "description": "Overseer primary buttons: start of the accent gradient.", "defaults": { "dark": "button.background", "light": "button.background", "highContrast": "button.background", "highContrastLight": "button.background" } },
      { "id": "overseer.accentEnd", "description": "Overseer primary buttons: end of the accent gradient.", "defaults": { "dark": "button.background", "light": "button.background", "highContrast": "button.background", "highContrastLight": "button.background" } }
    ],
    "customEditors": [
      { "viewType": "overseer.chatEditor", "displayName": "Overseer Agent Chat", "selector": [{ "filenamePattern": "*.overseer-chat" }], "priority": "default" }
    ],
    "icons": {
      "overseer-mark": { "description": "Overseer mark", "default": { "fontPath": "media/overseer-mark.woff", "fontCharacter": "\\E001" } }
    },
    "viewsContainers": {
      "activitybar": [{ "id": "overseer", "title": "Overseer", "icon": "media/overseer.svg" }],
      "panel": [{ "id": "overseer-talk", "title": "Overseer", "icon": "media/overseer.svg" }]
    },
    "views": {
      "overseer": [
        { "type": "webview", "id": "overseer.search", "name": "Search", "initialSize": 1 },
        { "id": "overseer.agents", "name": "Agents", "initialSize": 14 },
        { "id": "overseer.accounts", "name": "Accounts", "initialSize": 5 }
      ],
      "overseer-talk": [
        { "type": "webview", "id": "overseer.talk", "name": "Talk to Overseer" }
      ]
    },
    "viewsWelcome": [
      { "view": "overseer.agents", "contents": "No agent tasks yet.\n[New Task](command:overseer.newTask)\nOverseer runs agents through a local daemon; closing VS Code does not stop them.", "when": "isWorkspaceTrusted" },
      { "view": "overseer.agents", "contents": "Launching agents requires a trusted workspace.\n[Manage Workspace Trust](command:workbench.trust.manage)", "when": "!isWorkspaceTrusted" }
    ],
    "commands": [
      { "command": "overseer.openCenter", "title": "Open Overseer View", "category": "Overseer", "icon": "$(layout)" },
      { "command": "overseer.openDashboard", "title": "Open Dashboard", "category": "Overseer", "icon": "$(screen-full)" },
      { "command": "overseer.exitDashboard", "title": "Exit Dashboard", "category": "Overseer", "icon": "$(screen-normal)", "enablement": "overseer.inDashboard" },
      { "command": "overseer.toggleDashboard", "title": "Toggle Dashboard", "category": "Overseer" },
      { "command": "overseer.openDashboardWindow", "title": "Open Dashboard in New Window", "category": "Overseer", "icon": "$(empty-window)" },
      { "command": "overseer.newAgent", "title": "New Agent", "category": "Overseer", "icon": "$(add)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.toggleGrid", "title": "Toggle Agent Grid", "category": "Overseer", "icon": "$(layout)" },
      { "command": "overseer.resetGridLayout", "title": "Reset Grid Layout", "category": "Overseer" },
      { "command": "overseer.whereAmI", "title": "Where Am I", "category": "Overseer", "icon": "$(location)" },
      { "command": "overseer.talk", "title": "Talk to Overseer", "category": "Overseer", "icon": "$(comment-discussion)" },
      { "command": "overseer.switchAgent", "title": "Switch Agent…", "category": "Overseer", "icon": "$(list-selection)" },
      { "command": "overseer.nextNeedsYou", "title": "Go to Next Agent That Needs You", "category": "Overseer", "icon": "$(bell-dot)" },
      { "command": "overseer.allowPermission", "title": "Allow Pending Request", "category": "Overseer", "icon": "$(check)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.denyPermission", "title": "Deny Pending Request", "category": "Overseer", "icon": "$(circle-slash)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.stopSelected", "title": "Stop Selected Agent", "category": "Overseer", "icon": "$(debug-stop)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.cleanupArchived", "title": "Clean Up Archived Worktrees…", "category": "Overseer", "icon": "$(trash)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.newTask", "title": "New Task…", "category": "Overseer", "icon": "$(add)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.newTaskQuick", "title": "Start Task with Quick Picks…", "category": "Overseer", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.refresh", "title": "Refresh", "category": "Overseer", "icon": "$(refresh)" },
      { "command": "overseer.continuity.show", "title": "Connection and Continuity…", "category": "Overseer", "icon": "$(cloud)" },
      { "command": "overseer.continuity.checkNow", "title": "Check the Connection Now", "category": "Overseer", "icon": "$(sync)" },
      { "command": "overseer.continuity.toggle", "title": "Turn Continuity On or Off", "category": "Overseer", "icon": "$(cloud)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.continuity.localModels", "title": "Local Models…", "category": "Overseer", "icon": "$(server)" },
      { "command": "overseer.openReview", "title": "Open Review", "category": "Overseer", "icon": "$(diff-multiple)" },
      { "command": "overseer.showOutput", "title": "Show Output", "category": "Overseer", "icon": "$(output)" },
      { "command": "overseer.followUp", "title": "Send Follow-up…", "category": "Overseer", "icon": "$(comment)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.interrupt", "title": "Stop", "category": "Overseer", "icon": "$(debug-stop)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.searchAgents", "title": "Search Agents", "category": "Overseer", "icon": "$(search)" },
      { "command": "overseer.clearAgentSearch", "title": "Clear Search", "category": "Overseer", "icon": "$(search-stop)" },
      { "command": "overseer.showArchived", "title": "Show Archived Agents", "category": "Overseer", "icon": "$(archive)" },
      { "command": "overseer.hideArchived", "title": "Show Active Agents", "category": "Overseer", "icon": "$(list-unordered)" },
      { "command": "overseer.archiveAgent", "title": "Archive", "category": "Overseer", "icon": "$(archive)" },
      { "command": "overseer.restoreAgent", "title": "Restore", "category": "Overseer", "icon": "$(discard)" },
      { "command": "overseer.pinAgent", "title": "Pin to Grid", "category": "Overseer", "icon": "$(pin)" },
      { "command": "overseer.unpinAgent", "title": "Unpin from Grid", "category": "Overseer", "icon": "$(pinned)" },
      { "command": "overseer.openAgentToSide", "title": "Open to the Side", "category": "Overseer", "icon": "$(split-horizontal)" },
      { "command": "overseer.selectComparison", "title": "Select Comparison…", "category": "Overseer", "icon": "$(git-compare)" },
      { "command": "overseer.cleanupWorkspace", "title": "Clean Up Worktree…", "category": "Overseer", "icon": "$(trash)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.addProfile", "title": "Add Account…", "category": "Overseer", "icon": "$(person-add)" },
      { "command": "overseer.removeAccount", "title": "Remove Account…", "category": "Overseer", "icon": "$(trash)" },
      { "command": "overseer.signIn", "title": "Sign In…", "category": "Overseer", "icon": "$(sign-in)" },
      { "command": "overseer.signOut", "title": "Sign Out", "category": "Overseer", "icon": "$(sign-out)" },
      { "command": "overseer.renameProfile", "title": "Rename Account…", "category": "Overseer", "icon": "$(edit)" },
      { "command": "overseer.refreshAccounts", "title": "Refresh Account Status", "category": "Overseer", "icon": "$(refresh)" },
      { "command": "overseer.openEdit", "title": "Open Edit in Review", "category": "Overseer" },
      { "command": "overseer.showCapabilities", "title": "Show Harness Capabilities", "category": "Overseer", "icon": "$(info)" },
      { "command": "overseer.openPullRequest", "title": "Open Pull Request…", "category": "Overseer", "icon": "$(git-pull-request)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.mergeBack", "title": "Merge Back…", "category": "Overseer", "icon": "$(git-merge)", "enablement": "isWorkspaceTrusted" },
      { "command": "overseer.stopAll", "title": "Stop Agents and Daemon…", "category": "Overseer", "icon": "$(debug-stop)" },
      { "command": "overseer.startDaemon", "title": "Start Daemon", "category": "Overseer" },
      { "command": "overseer.audioMode", "title": "Audio Mode and Reactor Cues…", "category": "Overseer", "icon": "$(unmute)" },
      { "command": "overseer.voice.toggle", "title": "Voice Mode: Turn On or Off", "category": "Overseer", "icon": "$(mic)" },
      { "command": "overseer.voice.open", "title": "Voice Mode: Show", "category": "Overseer", "icon": "$(mic)" },
      { "command": "overseer.voice.mute", "title": "Voice Mode: Mute or Unmute", "category": "Overseer", "icon": "$(mute)", "enablement": "overseer.voiceOn" },
      { "command": "overseer.voice.talkTo", "title": "Voice Mode: Talk To…", "category": "Overseer", "enablement": "overseer.voiceOn" },
      { "command": "overseer.voice.cancel", "title": "Voice Mode: Cancel the Request", "category": "Overseer", "enablement": "overseer.voiceOn" },
      { "command": "overseer.voice.yes", "title": "Voice Mode: Yes", "category": "Overseer", "enablement": "overseer.voiceOn" },
      { "command": "overseer.voice.no", "title": "Voice Mode: No", "category": "Overseer", "enablement": "overseer.voiceOn" },
      { "command": "overseer.voice.simulate", "title": "Voice Mode: Simulate the Voice (development)", "category": "Overseer", "enablement": "overseer.voiceSimulated" },
      { "command": "overseer.testNotification", "title": "Test Notification", "category": "Overseer", "icon": "$(bell)" },
      { "command": "overseer.showLog", "title": "Show Daemon Log", "category": "Overseer" },
      { "command": "overseer.restartDaemonConnection", "title": "Reconnect to Daemon", "category": "Overseer" }
    ],
    "keybindings": [
      { "command": "overseer.archiveAgent", "key": "delete", "mac": "cmd+backspace", "when": "focusedView == overseer.agents" },
      { "command": "overseer.searchAgents", "key": "ctrl+alt+f", "mac": "cmd+alt+f", "when": "!editorTextFocus" },
      { "command": "overseer.clearAgentSearch", "key": "escape", "when": "focusedView == overseer.agents && overseer.agentsFiltered" },
      { "command": "overseer.toggleDashboard", "key": "ctrl+alt+o", "mac": "cmd+alt+o" },
      { "command": "overseer.voice.open", "key": "ctrl+alt+v", "mac": "cmd+alt+v" },
      { "command": "overseer.voice.toggle", "key": "ctrl+alt+shift+v", "mac": "cmd+alt+shift+v" },
      { "command": "overseer.voice.mute", "key": "ctrl+alt+shift+m", "mac": "cmd+alt+shift+m", "when": "overseer.voiceOn" },
      { "command": "overseer.voice.cancel", "key": "ctrl+alt+shift+.", "mac": "cmd+alt+shift+.", "when": "overseer.voiceOn" },
      { "command": "overseer.voice.yes", "key": "ctrl+alt+shift+y", "mac": "cmd+alt+shift+y", "when": "overseer.voiceOn && overseer.voiceAsking" },
      { "command": "overseer.voice.no", "key": "ctrl+alt+shift+n", "mac": "cmd+alt+shift+n", "when": "overseer.voiceOn && overseer.voiceAsking" },
      { "command": "overseer.newAgent", "key": "ctrl+alt+n", "mac": "cmd+alt+n" },
      { "command": "overseer.toggleGrid", "key": "ctrl+alt+g", "mac": "cmd+alt+g" },
      { "command": "overseer.whereAmI", "key": "ctrl+alt+m", "mac": "cmd+alt+m" },
      { "command": "overseer.switchAgent", "key": "ctrl+alt+a", "mac": "cmd+alt+a" },
      { "command": "overseer.nextNeedsYou", "key": "ctrl+alt+j", "mac": "cmd+alt+j" },
      { "command": "overseer.allowPermission", "key": "ctrl+alt+y", "mac": "cmd+alt+y", "when": "overseer.connected" },
      { "command": "overseer.denyPermission", "key": "ctrl+alt+x", "mac": "cmd+alt+backspace", "when": "overseer.connected" },
      { "command": "overseer.stopSelected", "key": "ctrl+alt+.", "mac": "cmd+alt+.", "when": "overseer.connected" }
    ],
    "menus": {
      "view/title": [
        { "command": "overseer.newAgent", "when": "view == overseer.agents", "group": "navigation@1" },
        { "command": "overseer.searchAgents", "when": "view == overseer.agents && !overseer.agentsFiltered", "group": "navigation@2" },
        { "command": "overseer.clearAgentSearch", "when": "view == overseer.agents && overseer.agentsFiltered", "group": "navigation@2" },
        { "command": "overseer.toggleGrid", "when": "view == overseer.agents", "group": "navigation@3" },
        { "command": "overseer.showArchived", "when": "view == overseer.agents && !overseer.showArchived", "group": "1_view@1" },
        { "command": "overseer.hideArchived", "when": "view == overseer.agents && overseer.showArchived", "group": "1_view@1" },
        { "command": "overseer.openDashboard", "when": "view == overseer.agents", "group": "1_view@2" },
        { "command": "overseer.switchAgent", "when": "view == overseer.agents", "group": "1_view@3" },
        { "command": "overseer.newTask", "when": "view == overseer.agents", "group": "2_new@1" },
        { "command": "overseer.cleanupArchived", "when": "view == overseer.agents", "group": "3_tidy@1" },
        { "command": "overseer.refresh", "when": "view == overseer.agents", "group": "3_tidy@2" },
        { "command": "overseer.showCapabilities", "when": "view == overseer.agents", "group": "4_info@1" },
        { "command": "overseer.audioMode", "when": "view == overseer.agents", "group": "5_audio@1" },
        { "command": "overseer.stopAll", "when": "view == overseer.agents", "group": "9_stop@1" },
        { "command": "overseer.addProfile", "when": "view == overseer.accounts", "group": "navigation@1" },
        { "command": "overseer.refreshAccounts", "when": "view == overseer.accounts", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "overseer.interrupt", "when": "view == overseer.agents && viewItem =~ /^agent-active/", "group": "inline@1" },
        { "command": "overseer.archiveAgent", "when": "view == overseer.agents && viewItem =~ /^agent-done(?!-archived)/", "group": "inline@2" },
        { "command": "overseer.restoreAgent", "when": "view == overseer.agents && viewItem =~ /^agent-done-archived/", "group": "inline@2" },
        { "command": "overseer.pinAgent", "when": "view == overseer.agents && viewItem =~ /^agent-(active|done)(?!.*-pinned)/", "group": "inline@3" },
        { "command": "overseer.unpinAgent", "when": "view == overseer.agents && viewItem =~ /-pinned$/", "group": "inline@3" },
        { "command": "overseer.openAgentToSide", "when": "view == overseer.agents && viewItem =~ /^(agent|needs)/", "group": "1_open@1" },
        { "command": "overseer.openReview", "when": "view == overseer.agents && viewItem =~ /^(agent-(active|done)|needs)/", "group": "1_open@2" },
        { "command": "overseer.followUp", "when": "view == overseer.agents && viewItem =~ /^agent-(active|done)/", "group": "2_control@1" },
        { "command": "overseer.selectComparison", "when": "view == overseer.agents && viewItem =~ /^agent-(active|done)/", "group": "2_control@2" },
        { "command": "overseer.mergeBack", "when": "view == overseer.agents && viewItem =~ /^agent-(active|done)/", "group": "2_control@3" },
        { "command": "overseer.openPullRequest", "when": "view == overseer.agents && viewItem =~ /^agent-(active|done)/", "group": "2_control@4" },
        { "command": "overseer.pinAgent", "when": "view == overseer.agents && viewItem =~ /^agent-(active|done)(?!.*-pinned)/", "group": "8_organize@1" },
        { "command": "overseer.unpinAgent", "when": "view == overseer.agents && viewItem =~ /-pinned$/", "group": "8_organize@1" },
        { "command": "overseer.archiveAgent", "when": "view == overseer.agents && viewItem =~ /^agent-done(?!-archived)/", "group": "8_organize@2" },
        { "command": "overseer.restoreAgent", "when": "view == overseer.agents && viewItem =~ /^agent-done-archived/", "group": "8_organize@2" },
        { "command": "overseer.cleanupWorkspace", "when": "view == overseer.agents && viewItem =~ /^agent-done/", "group": "9_cleanup@1" },
        { "command": "overseer.signIn", "when": "view == overseer.accounts && viewItem =~ /^profile-.*-signedout$/", "group": "inline@1" },
        { "command": "overseer.signIn", "when": "view == overseer.accounts && viewItem =~ /^profile-/", "group": "1_edit@0" },
        { "command": "overseer.renameProfile", "when": "view == overseer.accounts && viewItem =~ /profile-isolated/", "group": "1_edit@1" },
        { "command": "overseer.signOut", "when": "view == overseer.accounts && viewItem =~ /^profile-isolated-signedin$/", "group": "1_edit@2" },
        { "command": "overseer.removeAccount", "when": "view == overseer.accounts && viewItem =~ /profile-isolated/", "group": "9_remove@1" },
        { "command": "overseer.addProfile", "when": "view == overseer.accounts && viewItem == provider", "group": "inline@1" }
      ],
      "commandPalette": [
        { "command": "overseer.openEdit", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Overseer",
      "properties": {
        "overseer.grid.maxTiles": { "type": "integer", "minimum": 1, "maximum": 16, "default": 6, "markdownDescription": "How many running or pinned agents fill the agent grid on their own (1–16). Agents you drag in can fill it up to 16." },
        "overseer.dashboard.openOnStartup": { "type": "boolean", "default": false, "markdownDescription": "Open the Overseer dashboard when VS Code starts." },
        "overseer.chat.model": { "type": "string", "default": "", "markdownDescription": "The model Talk to Overseer asks for (for example `haiku`); empty uses the harness's default." },
        "overseer.chat.harness": { "type": "string", "enum": ["claude", "codex", "opencode"], "default": "claude", "markdownDescription": "The harness Talk to Overseer runs on (its default account)." },
        "overseer.sideBar.openOnStartup": { "type": ["boolean", "null"], "default": null, "markdownDescription": "Show Overseer in the side bar instead of Explorer when VS Code opens (Explorer stays one click away in the activity bar). Overseer asks once while this is not set." },
        "overseer.dashboard.immersive": { "type": "boolean", "default": true, "markdownDescription": "In the dashboard, hide VS Code's chrome above Overseer's views. While the dashboard is open Overseer sets these user settings, and puts back exactly what was there when you leave it: `workbench.editor.showTabs` = `none`, `breadcrumbs.enabled` = `false`, `workbench.editor.editorActionsLocation` = `hidden`." },
        "overseer.history.autoArchiveDays": { "type": "number", "minimum": 0, "default": 14, "markdownDescription": "Archive finished agents automatically after this many days (0 turns it off). Archived agents stay searchable and can be restored." },
        "overseer.showCodexAppServer": { "type": "boolean", "default": false, "markdownDescription": "Offer the Codex app-server harness in the new-agent composer (the New Task form always lists it)." },
        "overseer.continuity.enabled": { "type": "boolean", "default": true, "markdownDescription": "Continuity: when an agent loses its connection, continue on another provider that can be reached or on a local model. Off: agents wait and retry. Overseer's daemon keeps and enforces this, also with VS Code closed.", "order": 0 },
        "overseer.continuity.providerOrder": { "type": "array", "items": {"type": "string", "enum": ["openai", "anthropic"]}, "default": ["openai", "anthropic"], "markdownDescription": "Preference among providers that can be reached. Local models always come last. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.allowModelDownloads": { "type": "boolean", "default": false, "markdownDescription": "Let Overseer download local models from the Ollama registry when one is needed. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.allowOllamaInstall": { "type": "boolean", "default": false, "markdownDescription": "Let Overseer install Ollama (Homebrew, or the official archive after its signature verifies) and start it when nothing is running. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.prefetch": { "type": "boolean", "default": false, "markdownDescription": "While online and downloads are allowed, keep the best-fitting local model downloaded. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.ramCeilingPercent": { "type": "integer", "minimum": 10, "maximum": 50, "default": 40, "markdownDescription": "Share of total memory one local model may take. Never over 50. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.ramHeadroomGiB": { "type": ["number", "null"], "minimum": 1, "maximum": 1024, "default": null, "markdownDescription": "Free memory that must remain after a model loads, in GiB. Empty: 4 GiB or 10% of total, whichever is more. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.contextTarget": { "type": "integer", "minimum": 8192, "maximum": 1048576, "default": 65536, "markdownDescription": "Preferred context length for local models, in tokens. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.contextFloor": { "type": "integer", "minimum": 8192, "maximum": 262144, "default": 16384, "markdownDescription": "Shortest context Overseer runs a coding agent at, in tokens. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.preferredModels": { "type": "array", "items": {"type": "string"}, "default": [], "markdownDescription": "Local models tried first, in this order (Ollama tags). Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.allowUnverifiedModels": { "type": "boolean", "default": false, "markdownDescription": "Let automatic picks use installed models that call tools but have not passed Overseer's check. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.localHarness": { "type": "string", "enum": ["opencode", "codex"], "default": "opencode", "markdownDescription": "The harness local models run in. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.returnOnline": { "type": "string", "enum": ["offer", "auto", "stay"], "default": "offer", "markdownDescription": "When the connection is back: offer to switch back, switch at the next message, or stay. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.retryCapSeconds": { "type": "integer", "minimum": 5, "maximum": 3600, "default": 120, "markdownDescription": "Longest wait between two retries, in seconds. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.retryForHours": { "type": "integer", "minimum": 1, "maximum": 36, "default": 36, "markdownDescription": "Stop waiting after this many hours. Never over 36. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.stallSeconds": { "type": "integer", "minimum": 30, "maximum": 3600, "default": 90, "markdownDescription": "Silence while offline before Overseer interrupts a turn, in seconds. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.probes": { "type": "boolean", "default": true, "markdownDescription": "Check reachability with small requests that carry no credentials. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.ollamaIdleMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 30, "markdownDescription": "Stop an Ollama that Overseer started after this many idle minutes. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.continuity.registry": { "type": "string", "default": "", "markdownDescription": "Mirror for model downloads. Empty: Ollama's own registry. Overseer's daemon keeps and enforces this, also with VS Code closed." },
        "overseer.github.apiUrl": { "type": "string", "default": "https://api.github.com", "description": "GitHub API base URL used by Open Pull Request (GitHub Enterprise: https://HOST/api/v3). Pull requests use the GitHub account VS Code is signed in to." },
        "overseer.daemonPath": { "type": "string", "default": "", "markdownDescription": "Path to the `overseerd` binary. Empty uses the binary bundled with the extension.", "scope": "machine" },
        "overseer.review.enableEditing": { "type": "boolean", "default": true, "markdownDescription": "Edit working-tree text directly in the review. Undo/redo is available through Open in Native Diff." },
        "overseer.review.largeDiffThreshold": { "type": "integer", "minimum": 1, "default": 500, "markdownDescription": "Show a Load Diff card when additions + deletions exceed this count." },
        "overseer.followNewRuns": { "type": "boolean", "default": true, "markdownDescription": "Turn Follow on for runs you launch from this window. Selecting an existing run never turns Follow on." }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/daemon-client.js && node --check src/views.js && node --check src/review.js && node --check src/output-panel.js && node --check branch-diff/review/panel.js",
    "build:review": "node branch-diff/scripts/build-review.js",
    "package": "node scripts/package.js",
    "test": "node ../test/unit/run.js"
  }
}
